{
  "name": "tastebuds",
  "version": "0.3.0",
  "private": true,
  "description": "Keep a taste profile: the people and work whose taste you watch, and the ones that shaped your own work.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --base ./",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "test": "node --test",
    "build:field": "vite build --config packages/editor-field/vite.config.ts",
    "example:field": "vite packages/editor-field --port 4174 --strictPort"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tastebuds-editor-field": "*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
